<Window x:Class="SvuSessionsLauncher.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Session Viewer"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="640" Width="1024"
        MinHeight="220" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="False"
        WindowStyle="None"
        ResizeMode="CanResize"
        FlowDirection="LeftToRight"
        Background="{DynamicResource Brush.Background}">

    <!-- A single, standard-height title bar drawn by us (WindowChrome) instead
         of a real OS caption plus a second, taller custom bar. It keeps normal
         drag, double-click-maximise, resize and Aero-snap behaviour, and hosts
         the session-audio and microphone controls. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Speaker / microphone status icons (24x24 stroke paths). -->
        <StreamGeometry x:Key="ViewIcon.Volume">M11 5L6 9H2v6h4l5 4V5z M15.54 8.46a5 5 0 0 1 0 7.07 M19.07 4.93a10 10 0 0 1 0 14.14</StreamGeometry>
        <StreamGeometry x:Key="ViewIcon.VolumeMute">M11 5L6 9H2v6h4l5 4V5z M22 9l-6 6 M16 9l6 6</StreamGeometry>
        <StreamGeometry x:Key="ViewIcon.Mic">M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z M18 10v2a6 6 0 0 1-12 0v-2 M12 18v4 M8 22h8</StreamGeometry>
        <StreamGeometry x:Key="ViewIcon.MicOff">M1 1l22 22 M9 9v3a3 3 0 0 0 5.12 2.12 M15 9.34V4a3 3 0 0 0-5.94-0.6 M18 10v2a6 6 0 0 1-1.3 3.7 M12 18v4 M8 22h8</StreamGeometry>

        <!-- Window-button glyphs (16x16 box, drawn 1:1). -->
        <StreamGeometry x:Key="ViewIcon.Min">M4 8H12</StreamGeometry>
        <StreamGeometry x:Key="ViewIcon.Max">M4 4H12V12H4Z</StreamGeometry>
        <StreamGeometry x:Key="ViewIcon.Restore">M6 4H12V10H6Z M4 6V12H10</StreamGeometry>
        <StreamGeometry x:Key="ViewIcon.Close">M4 4L12 12 M12 4L4 12</StreamGeometry>

        <!-- Speaker / microphone glyph look. -->
        <Style x:Key="TitleGlyph" TargetType="Path">
            <Setter Property="Fill" Value="{x:Null}"/>
            <Setter Property="Stroke" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="SnapsToDevicePixels" Value="False"/>
        </Style>

        <!-- Window-button glyph look (literal coordinates, centred in the button). -->
        <Style x:Key="CaptionGlyph" TargetType="Path">
            <Setter Property="Fill" Value="{x:Null}"/>
            <Setter Property="Stroke" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="SnapsToDevicePixels" Value="False"/>
        </Style>

        <!-- Speaker toggle (received session audio mute/unmute). -->
        <Style x:Key="AudioToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            SnapsToDevicePixels="False" UseLayoutRounding="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact themed volume slider for the title bar. -->
        <Style x:Key="TitleSlider" TargetType="Slider">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.Border}"
                                    SnapsToDevicePixels="False" UseLayoutRounding="True"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource Brush.Primary}"
                                                CornerRadius="6" BorderBrush="White" BorderThickness="1"
                                                SnapsToDevicePixels="False" UseLayoutRounding="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption buttons. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScaleChoice" TargetType="RadioButton">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="GroupName" Value="ViewerScale"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="False"
                                UseLayoutRounding="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.SurfaceAlt}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.Border}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource Brush.PrimarySoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.DangerHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Single normal-height title bar. Forced LeftToRight so the caption and
             window buttons keep their English order (buttons on the right) even
             when the app is running in Arabic/RTL. -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                FlowDirection="LeftToRight">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Width="16" Height="16"
                           Source="pack://application:,,,/Assets/app.ico"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Session Viewer"
                               Margin="8,0,0,0"
                               FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text}"/>
                </StackPanel>

                <!-- Scale presets keep the shared frame's aspect, so the viewport
                     stays free of letterbox bars at every size. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="14,0,8,0">
                    <RadioButton x:Name="ScaleResetButton"
                                 Style="{StaticResource ScaleChoice}" Content="Reset"
                                 IsChecked="True"
                                 Click="ScaleReset_Click"
                                 ToolTip="Actual size"/>
                    <RadioButton x:Name="ScaleDoubleButton"
                                 Style="{StaticResource ScaleChoice}" Content="2x"
                                 Click="ScaleDouble_Click"
                                 ToolTip="Double size"/>
                    <RadioButton x:Name="ScaleTripleButton"
                                 Style="{StaticResource ScaleChoice}" Content="3x"
                                 Click="ScaleTriple_Click"
                                 ToolTip="Triple size"/>
                    <RadioButton x:Name="ScaleMaxButton"
                                 Style="{StaticResource ScaleChoice}" Content="Max"
                                 Click="ScaleMax_Click"
                                 ToolTip="Largest size that still fits the screen"/>
                </StackPanel>

                <!-- Session audio + microphone status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <ToggleButton x:Name="AudioMuteToggle"
                                  Style="{StaticResource AudioToggle}"
                                  IsChecked="False"
                                  Click="AudioMuteToggle_Click"
                                  ToolTip="Mute or unmute the shared session audio">
                        <Path x:Name="AudioIcon" Style="{StaticResource TitleGlyph}"/>
                    </ToggleButton>

                    <Slider x:Name="AudioVolumeSlider"
                            Style="{StaticResource TitleSlider}"
                            Minimum="0" Maximum="300" Value="100"
                            Margin="4,0,2,0"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            ValueChanged="AudioVolumeSlider_ValueChanged"/>

                    <TextBlock Text="{Binding ElementName=AudioVolumeSlider, Path=Value, StringFormat={}{0:F0}%}"
                               Width="34" VerticalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Muted}"/>

                    <Border Width="1" Height="16" Margin="6,0"
                            Background="{DynamicResource Brush.Border}"/>

                    <Path x:Name="MicIcon" Style="{StaticResource TitleGlyph}"
                          Margin="2,0,4,0"
                          ToolTip="Microphone is always muted"/>
                </StackPanel>

                <!-- Minimise / maximise. There is deliberately no close button:
                     the viewer is closed only by the launcher, when the session
                     or the screen share ends. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="MinButton" Style="{StaticResource CaptionButton}"
                            Click="MinButton_Click" ToolTip="Minimise">
                        <Path Style="{StaticResource CaptionGlyph}"
                              Data="{StaticResource ViewIcon.Min}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}"
                            Click="MaxButton_Click" ToolTip="Maximise">
                        <Path x:Name="MaxIcon" Style="{StaticResource CaptionGlyph}"
                              Data="{StaticResource ViewIcon.Max}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Viewer viewport -->
        <Grid Grid.Row="1" Background="Black">
            <Image x:Name="ViewportImage"
                   Stretch="Uniform"
                   SnapsToDevicePixels="False"
                   FlowDirection="LeftToRight"/>
            <Border Background="Black"
                    Visibility="{Binding HasNoFrame, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
                <TextBlock Text="Waiting for screen share..."
                           Foreground="#8FA8B0"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Window>
